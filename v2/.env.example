# Copie para servidor/.env (ignorado pelo git). NUNCA commite o .env real.

# --- Broker MQTT ---
# broker.hivemq.com é PÚBLICO: qualquer pessoa lê e escreve. Só para testes, nunca dados reais.
ANIMA_MQTT_HOST=broker.hivemq.com
ANIMA_MQTT_PORT=1883
ANIMA_MQTT_USER=
ANIMA_MQTT_PASS=
# 1 para usar TLS (normalmente porta 8883)
ANIMA_MQTT_TLS=0

# O token do Wokwi (WOKWI_CLI_TOKEN) NÃO vai aqui nem em arquivo nenhum: só variável de ambiente (docs/wokwi_cli.md).

# --- Telegram (opcional; sem isso, só imprime no terminal) ---
# Crie o bot com @BotFather e descubra o chat id (veja docs/passo_a_passo.md). O .env real fica em v2/servidor/.env
# (nomes antigos ANIMA_TELEGRAM_TOKEN / ANIMA_TELEGRAM_CHAT_ID continuam aceitos)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Regras do servidor (opcionais; valores padrão mostrados) ---
# ANIMA_JANELAS_CONSECUTIVAS=2
# ANIMA_INTERVALO_NOTIF_S=300
# ANIMA_LIMIAR_CONFIANCA=0.6
# ANIMA_PARADO_LETARGIA_JANELAS=0   # 0 = desligado
